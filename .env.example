# Copy this file to .env and fill in your own values. Never commit .env.

# LLM backend: "ollama" (free, runs locally, see https://ollama.com) or "claude" (paid API)
BIORAG_LLM_BACKEND=ollama
BIORAG_OLLAMA_MODEL=qwen2.5:3b

# Only needed for the claude backend: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# NCBI asks API users for a contact email (only needed for `biorag fetch-pubmed`)
NCBI_EMAIL=
# Optional: raises the NCBI rate limit from 3 to 10 requests/second
NCBI_API_KEY=

# Models (defaults shown)
BIORAG_GENERATOR_MODEL=claude-opus-5-5
BIORAG_JUDGE_MODEL=claude-haiku-5-5

# Embedding model. bge-small runs fine on CPU; try BAAI/bge-large-en-v1.5 on a GPU.
BIORAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
BIORAG_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
